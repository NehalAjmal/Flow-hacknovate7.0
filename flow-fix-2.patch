+  final String route;
+  final Widget child;
+
+  static final _seen = <String>{};
+
+  /// False on a revisit; true outside any scope (dialogs, signed-out pages).
+  static bool animates(BuildContext context) => context.getInheritedWidgetOfExactType<_AppearFlag>()?.animate ?? true;
