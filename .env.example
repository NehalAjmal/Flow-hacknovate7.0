# ── FLOW — Environment Variables ─────────────────────────
# Copy this file to `.env` and fill in your real values.
#
#   cp .env.example .env
#
# NEVER commit the real `.env` to version control.
# ─────────────────────────────────────────────────────────

# A random 256-bit hex string used to sign JWT tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<generate-a-random-hex-string>

# MySQL connection string. Replace YOURPWD with your MySQL root password.
DATABASE_URL=mysql+pymysql://root:YOURPWD@localhost/flow_db

# Google Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=<your-gemini-api-key>

# Google OAuth 2.0 Client ID (optional — enables Google Sign-In)
GOOGLE_CLIENT_ID=<your-google-client-id>
